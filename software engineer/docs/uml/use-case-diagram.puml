@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor White
  BorderColor Black
}

actor Student
actor Teacher
actor Admin
actor "AI Analysis Engine" as AIEngine
actor "AI Speech Recognition Engine" as SpeechEngine
actor "Notification Service" as Notif
actor Chatbot

rectangle "Personalized Learning Content System" {
  (User Registration,\nLogin and Email\nVerification) as UC1
  (Register) as UC1R
  (Login) as UC1L
  (Email Verification) as UC1V

  (Account Recovery) as UC2
  (Send Reset Link) as UC2S
  (Reset Password) as UC2P

  (Placement Test) as UC3
  (Speaking Test and\nSpeech Analysis) as UC4
  (Listening, Reading\nand Writing Modules) as UC5
  (Reading Module) as UC5R
  (Writing Module) as UC5W
  (Listening Module) as UC5L
  (Speaking Module) as UC5S
  (Displaying Test\nResults) as UC6
  (Interim Results\n(after each module)) as UC6I
  (Overall Level Report\n(end of test)) as UC6F

  (Student Analysis and\nPersonalized Content Plan) as UC7
  (AI-Based Content\nDelivery) as UC8
  (Content Update and\nReasoning Explanation) as UC9
  (Automatic Feedback) as UC12

  (Student Progress\nTracking) as UC10
  (Store Progress\nStatus in DB) as UC10S
  (Data Export) as UC11
  (Export CSV) as UC11C
  (Export PDF) as UC11P

  (Submitting Feedback\nto the System) as UC13
  (Rewards, Motivation and\nNotification System) as UC14
  (Daily Streak) as UC14D
  (Reminder Notification) as UC14R

  (Messaging and\nAnnouncement System) as UC18
  (Direct Messaging) as UC18M
  (Announcements) as UC18A

  (Teacher–AI\nCollaboration) as UC19
  (Assignment of\nHomework or\nTasks) as UC15

  (Account Management) as UC16
  (System Performance and\nMaintenance\nManagement) as UC17

  (Chatbot Interaction) as UC20
  (Ask Question\nabout Lessons/Exercises) as UC20Q
}

' include / extend relations (FR/UC alignment)
UC1 ..> UC1R : <<include>>
UC1 ..> UC1L : <<include>>
UC1 ..> UC1V : <<include>>

UC2 ..> UC2S : <<include>>
UC2 ..> UC2P : <<include>>

' Placement test structure
UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC5 ..> UC5R : <<include>>
UC5 ..> UC5W : <<include>>
UC5 ..> UC5L : <<include>>
UC5 ..> UC5S : <<include>>

' Result screens
UC6I ..> UC6 : <<extend>>
UC6F ..> UC6 : <<extend>>
UC4 ..> UC6I : <<include>>
UC5 ..> UC6I : <<include>>
UC3 ..> UC6F : <<include>>

' Teacher/AI flow
UC7 ..> UC6F : <<include>>
UC9 ..> UC8 : <<include>>
UC19 ..> UC8 : <<include>>

' Progress + export
UC10 ..> UC10S : <<include>>
UC11 ..> UC10 : <<extend>>
UC11 ..> UC11C : <<include>>
UC11 ..> UC11P : <<include>>

' Rewards + notifications
UC14 ..> UC14D : <<include>>
UC14 ..> UC14R : <<include>>

' Messaging split
UC18 ..> UC18M : <<include>>
UC18 ..> UC18A : <<include>>

' Chatbot Q&A
UC20 ..> UC20Q : <<include>>

' Primary actor associations
Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4
Student --> UC5
Student --> UC6
Student --> UC8
Student --> UC9
Student --> UC10
Student --> UC11
Student --> UC13
Student --> UC14
Student --> UC18
Student --> UC20

Teacher --> UC1
Teacher --> UC2
Teacher --> UC6
Teacher --> UC10
Teacher --> UC11
Teacher --> UC15
Teacher --> UC18
Teacher --> UC19

Admin --> UC1
Admin --> UC2
Admin --> UC16
Admin --> UC17

' External systems
AIEngine --> UC7
AIEngine --> UC8
AIEngine --> UC9
AIEngine --> UC12
AIEngine --> UC10

SpeechEngine --> UC4

Notif --> UC1
Notif --> UC2
Notif --> UC14
Notif --> UC18

Chatbot --> UC20

@enduml
